# =============================================================================
# AuthorizeCheck — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and populate with your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google SMTP & Email Notification Settings (Nodemailer)
# -----------------------------------------------------------------------------
# To send emails using Google SMTP (Gmail), generate a 16-character
# Google App Password from your Google Account:
# 1. Go to https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is active.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Enter an App name (e.g. "AuthorizeCheck") and click "Create".
# 5. Copy the 16-character password into GMAIL_APP_PASSWORD below.
# -----------------------------------------------------------------------------
GMAIL_USER=checkauthorize@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
ORDER_NOTIFICATION_EMAIL=checkauthorize@gmail.com

# -----------------------------------------------------------------------------
# 2. VehicleDataGlobal (UK Vehicle Data API)
# -----------------------------------------------------------------------------
# Primary API key and endpoint for fetching vehicle provenance, MOT history,
# mileage records, finance, stolen registers, and valuations.
# -----------------------------------------------------------------------------
VDG_API_KEY=0E034E63-E224-4F07-9AFF-B083E9FAB611
VDG_API_BASE_URL=https://uk1.ukvehicledata.co.uk
VDG_DATA_PACKAGE=VehicleData

# -----------------------------------------------------------------------------
# 3. Resend Email Delivery (Optional Alternative to Google SMTP)
# -----------------------------------------------------------------------------
# If RESEND_API_KEY is provided, report emails will be dispatched via Resend.
# If absent or invalid, the system automatically falls back to Google SMTP (Nodemailer).
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=AuthorizeCheck <reports@authorizecheck.co.uk>

# -----------------------------------------------------------------------------
# 4. Vercel Blob Cloud Storage (Recommended for Production / Vercel Serverless)
# -----------------------------------------------------------------------------
# In Vercel serverless environments, the local filesystem is ephemeral.
# Connect a Vercel Blob store in your Vercel project settings to automatically
# populate BLOB_READ_WRITE_TOKEN. The PDF reports will be securely uploaded
# and publicly downloadable via CDN links.
# If not set, falls back to local server storage / temporary storage.
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 5. Admin Dashboard Security
# -----------------------------------------------------------------------------
# Protects the `/admin/orders` dashboard and management API (`/api/admin/orders`).
# If left unset or blank, access is allowed for local development convenience.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change_this_secure_admin_password_in_production
